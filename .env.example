# Copia este archivo a .env y ajusta los valores.
# docker compose lo lee automáticamente.

# --- Base de datos ---
DB_NAME=Proyecto_EEG
DB_USER=root
DB_PASSWORD=diana
# Puerto del host -> MySQL del contenedor. Usa 3307 si ya tienes MySQL local en 3306.
DB_PORT=3307

# --- Puertos publicados en el host ---
CLIENT_PORT=8080
SERVER_PORT=3000

# --- Server ---
# URL pública del front (para los links de correos de recuperación)
APP_URL=http://localhost:8080
RESEND_API_KEY=
